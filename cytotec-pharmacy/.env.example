# IPinfo API token (required for IP enrichment)
# https://ipinfo.io/dashboard/token
IPINFO_TOKEN=

# DEPRECATED — fingerprints are always monitor-only (never HTTP 403).
# Safe to delete from Vercel if present. Kept only for backward compatibility.
# VISITOR_BLOCK_MODE=monitor

# Optional override for Google Apps Script Web App (lead → Google Sheet)
# Defaults to the production Web App URL if unset.
# GOOGLE_SHEETS_WEBAPP_URL=

# Optional: set automatically by Next.js / Vercel
# NODE_ENV=development
