# IPinfo API token (required for IP enrichment)
# https://ipinfo.io/dashboard/token
IPINFO_TOKEN=

# Fingerprint denylist mode for BLOCKED_VISITOR_IDS:
#   monitor (default) — UAE residential: allow page + WhatsApp, log flagged
#   hard — always HTTP 403 for blacklisted visitorIds
VISITOR_BLOCK_MODE=monitor

# Optional: set automatically by Next.js / Vercel
# NODE_ENV=development
